# ==========================================
# CardboardPackage Environment Variables
# ==========================================

# 1. JWT Session Secret (Required)
# Used to sign session tokens and secure cookies for admin and user authentication.
# Generate any secure 32+ character string (e.g. openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_min_32_characters_here

# 2. Stripe Secret Key (Required for Checkout)
# From Stripe Dashboard -> Developers -> API keys
# Test: sk_test_... | Live: sk_live_...
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# 3. Application Public URL (Recommended for Vercel)
# The full public URL of your Vercel deployment without trailing slash.
# Used for Stripe checkout return redirects (success/cancel).
NEXT_PUBLIC_APP_URL=https://your-vercel-project.vercel.app

# 4. Admin Login Credentials (Recommended for Vercel)
# Enables admin login at /admin-login on serverless platforms where data/ files are ephemeral.
ADMIN_EMAIL=admin@cardboardpackage.com
ADMIN_PASSWORD=your_secure_admin_password_here

# 5. Image Fallback Origin (Optional)
# If a requested upload image is not found in public/uploads, proxy from this URL.
IMAGE_FALLBACK_ORIGIN=https://cardboardpackage.com
